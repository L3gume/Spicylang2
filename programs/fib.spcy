let fib = \(n : int) => match n
    | 0 => 1
    | 1 => 1
    | x => fib (x - 1) + fib (x - 2)
    ;

let tl_fib = \(n : int) =>
    let loop = \i a b =>
        if i == n then
            a
        else
            loop (i+1) (b) (a+b)
    in loop 0 1 1;

println (itostr (tl_fib 40));

let f = \(n:int) => true || (fib n == 0);

println (btostr (f 40));
