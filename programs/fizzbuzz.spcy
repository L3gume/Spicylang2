# call the function fn n times
let for_n = \n fn =>
    let inner = (\idx =>
        if idx < n then
        {
            let _ = fn idx;
            inner (idx + 1)
        }
        else ())
    in inner 1;

# fizzbuzz impl
let fizzbuzz = \n =>
    if (n % 15) == 0 then
        { print "fizzbuzz "; () }
    else if (n % 3) == 0 then
        { print "fizz "; () }
    else if (n % 5) == 0 then
        { print "buzz "; () }
    else ();

for_n 30 fizzbuzz;
