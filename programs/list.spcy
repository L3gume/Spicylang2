
let iter = \fn ls => match ls
    | [] => ()
    | x::xs => {
        let unit = fn x;
        iter fn xs
    };

let map = \fn ls => match ls
    | [] => []
    | x::xs => (fn x)::(map fn xs);

let lfold = \fn acc ls => match ls
    | [] => acc
    | x::xs => lfold fn (fn acc x) ls;

let add = \x y => x + y;

let sum = lfold add 0;

let fib = \(n : int) => match n
    | 0 => 1
    | 1 => 1
    | x => fib (x - 1) + fib (x - 2)
    ;

let tl_fib = \(n : int) =>
    let loop = \i a b =>
        if i == n then
            a
        else
            loop (i+1) (b) (a+b)
    in loop 0 1 1;

sum (map tl_fib [1,2,3,4,5]);
