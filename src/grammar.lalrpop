use crate::ast::*;
use crate::types::Monotype;
use crate::types::TypeContext;
use std::str::FromStr;

grammar;

pub Prog: Box<Program> = <ss:SemiCol<Stmt>> => Box::new(Program { stmts : ss, ctx : TypeContext::new() });

pub Stmt: Stmt = {
    BlockStmt   => <>,
    <e:Expr>    => Stmt::from(SNode::Expr(e)),
};

// Statements allowed inside a block — no bare Expr variant to keep LR(1).
BlockStmt: Stmt = {
    "let" <n:Name> ":" <t:Type> "=" <e:Expr>    => Stmt::from(SNode::Decl(Box::new(Expr::from(ENode::Variable(n))), t, e)),
    "let" <n:Name> "=" <e:Expr>                 => Stmt::from(SNode::Decl(Box::new(Expr::from(ENode::Variable(n))), Box::new(Type { t : Monotype::infer() }), e)),
    "print" <e:Atom>                            => Stmt::from(SNode::Print(e)),
};

// Zero or more BlockStmt;s for the statement prefix of a block expression.
BlkBody: Vec<Stmt> = {
    => vec![],
    <mut v:BlkBody> <s:BlockStmt> ";" => { v.push(s); v },
}

// Precedence cascade: lowest to highest
//   LogExpr < CmpExpr < AddExpr < MulExpr < AppExpr < Atom

pub Expr: Box<Expr> = {
    Abs_Expr                                            => <>,
    "let" <n:Name> "=" <e1:Expr> "in" <e2:Expr>         => Box::new(Expr::from(ENode::Let(n, e1, e2))),
    "if" <c:Expr> "then" <e1:Expr> "else" <e2:Expr>     => Box::new(Expr::from(ENode::IfElse(c, e1, e2))),
    LogExpr                                             => <>,
    "{" <ss:BlkBody> <e:Expr> "}"                       => Box::new(Expr::from(ENode::Block(ss, e))),
    "[" <es:Comma<Expr>> "]"                            => Box::new(Expr::from(ENode::List(es.into_iter().map(|b| *b).collect()))),
    // TODO: pattern matching
};

// TODO: function currying (multiple binders)
Abs_Expr: Box<Expr> = {
    "\\" <b:Binding> "=>" <t:Expr>                      => Box::new(Expr::from(ENode::Abstraction(b, t))),
}

// --- Lowest precedence: logical (||, &&, ^) ---
LogExpr: Box<Expr> = {
    CmpExpr => <>,
    <e1:LogExpr> "||" <e2:CmpExpr> => Box::new(Expr::from(ENode::Logical(LogicalOp::Or, e1, e2))),
    <e1:LogExpr> "&&" <e2:CmpExpr> => Box::new(Expr::from(ENode::Logical(LogicalOp::And, e1, e2))),
    <e1:LogExpr> "^"  <e2:CmpExpr> => Box::new(Expr::from(ENode::Logical(LogicalOp::Xor, e1, e2))),
}

// --- Comparison (==, !=, <, >, <=, >=) ---
CmpExpr: Box<Expr> = {
    AddExpr => <>,
    <e1:AddExpr> "==" <e2:AddExpr> => Box::new(Expr::from(ENode::Comparison(CompOp::Eq, e1, e2))),
    <e1:AddExpr> "!=" <e2:AddExpr> => Box::new(Expr::from(ENode::Comparison(CompOp::NotEq, e1, e2))),
    <e1:AddExpr> "<"  <e2:AddExpr> => Box::new(Expr::from(ENode::Comparison(CompOp::Less, e1, e2))),
    <e1:AddExpr> ">"  <e2:AddExpr> => Box::new(Expr::from(ENode::Comparison(CompOp::Greater, e1, e2))),
    <e1:AddExpr> "<=" <e2:AddExpr> => Box::new(Expr::from(ENode::Comparison(CompOp::LessEq, e1, e2))),
    <e1:AddExpr> ">=" <e2:AddExpr> => Box::new(Expr::from(ENode::Comparison(CompOp::GreatEq, e1, e2))),
}

// --- Addition/subtraction (+, -) ---
AddExpr: Box<Expr> = {
    MulExpr => <>,
    <e1:AddExpr> "+" <e2:MulExpr> => Box::new(Expr::from(ENode::Arithmetic(ArithOp::Plus, e1, e2))),
    <e1:AddExpr> "-" <e2:MulExpr> => Box::new(Expr::from(ENode::Arithmetic(ArithOp::Minus, e1, e2))),
}

// --- Multiplication/division/modulo (*, /, %) ---
MulExpr: Box<Expr> = {
    UnaryExpr => <>,
    <e1:MulExpr> "*" <e2:UnaryExpr> => Box::new(Expr::from(ENode::Arithmetic(ArithOp::Times, e1, e2))),
    <e1:MulExpr> "/" <e2:UnaryExpr> => Box::new(Expr::from(ENode::Arithmetic(ArithOp::Div, e1, e2))),
    <e1:MulExpr> "%" <e2:UnaryExpr> => Box::new(Expr::from(ENode::Arithmetic(ArithOp::Mod, e1, e2))),
}

UnaryExpr: Box<Expr> = {
    AppExpr => <>,
    "-" <e:UnaryExpr> => Box::new(Expr::from(ENode::Unary(UnaryOp::Negate, e))),
    "!" <e:UnaryExpr> => Box::new(Expr::from(ENode::Unary(UnaryOp::Not, e))),
}

// --- Function application (highest binary precedence) ---
AppExpr: Box<Expr> = {
    Atom                        => <>,
    <t1:AppExpr> <t2:Atom>      => Box::new(Expr::from(ENode::Application(t1, t2)))
};

// --- Atoms (primary expressions) ---
Atom: Box<Expr> = {
    Name                        => Box::new(Expr::from(ENode::Variable(<>))),
    Literal                     => Box::new(Expr::from(ENode::Literal(<>))),
    "(" <e:Expr> ")"            => e
};

Binding: Box<Binding> = {
    Name                            => Box::new(Binding(<>, Box::new(Type { t: Monotype::infer() }))),
    "(" <n:Name> ":" <t:Type> ")"   => Box::new(Binding(n, t)),
}

Name: String = {
    r"[a-zA-Z_][a-zA-Z0-9_]*"   => <>.to_string()
};

Literal: Box<Lit> = {
    <n:r"[0-9]+\.[0-9]+"> => Box::new(Lit::Float(f32::from_str(n).unwrap())),
    <n:r"[0-9]+">         => Box::new(Lit::Int(i32::from_str(n).unwrap())),
    "true"                  => Box::new(Lit::Bool(true)),
    "false"                 => Box::new(Lit::Bool(false)),
    <s:r#"\"[^"]*\""#>      => Box::new(Lit::Str(s[1..s.len()-1].to_string())),
    "()"                    => Box::new(Lit::Unit),
}

// ----------------------------------------------------------------------------
// Types
// ----------------------------------------------------------------------------

Type: Box<Type> = {
    SimpleType => <>,
    <t1:SimpleType> "=>" <t2:Type> => Box::new(Type { t: Monotype::func(vec![t1.t.clone(), t2.t.clone()]) })
};

SimpleType: Box<Type> = {
    "int"       => Box::new(Type { t: Monotype::int() }),
    "bool"      => Box::new(Type { t: Monotype::bool() }),
    "float"     => Box::new(Type { t: Monotype::float() }),
    "str"       => Box::new(Type { t: Monotype::string() }),
    "()"        => Box::new(Type { t: Monotype::unit() }),
};

// ----------------------------------------------------------------------------
// Util
// ----------------------------------------------------------------------------

Comma<T>: Vec<T> = {
    <mut vec:(<T> ",")*> <e:T?> => match e {
        None => vec,
        Some(e) => {
            vec.push(e);
            vec
        }
    }
};

SemiCol<T>: Vec<T> = {
    <mut vec:(<T> ";")*> <e:T?> => match e {
        None => vec,
        Some(e) => {
            vec.push(e);
            vec
        }
    }
};
