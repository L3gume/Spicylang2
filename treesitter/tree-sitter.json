{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "merlin",
      "camelcase": "Merlin",
      "title": "Merlin",
      "scope": "source.merlin",
      "file-types": [
        "mln"
      ],
      "injection-regex": "^merlin$",
      "class-name": "TreeSitterMerlin",
      "highlights": "queries/merlin/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "tree-sitter parser for Merlin",
    "authors": [
      {
        "name": "Justin Tremblay",
        "url": "https://github.com/L3gume"
      }
    ],
    "links": {
      "repository": "https://github.com/L3gume/merlin-lang",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
